# npm run dev explicitly selects development. npm start fails closed if NODE_ENV
# is unset. Set NODE_ENV=production in hosting; production APIs remain disabled
# until identity and persistence adapters are implemented.
PORT=4320
CLIENT_ORIGIN=http://127.0.0.1:5173
# AUTH_SECRET is optional only in development/test (ephemeral process key).
# Outside development supply a secret-manager value of at least 32 characters.
# AUTH_SECRET=
# CLIENT_ORIGIN=https://treasury.example.com,https://other-approved.example.com
# JWT_SECRET and production DEV_OTP are rejected. Fixed OTP overrides are unused.

# Required when the Supabase repository/auth adapter is enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=server-only-secret-key

# Only set when the browser must call a separately hosted API.
# VITE_API_BASE_URL=https://api.example.com

# Optional future Customer.io server adapter. Never expose these as VITE_ variables.
CUSTOMER_IO_APP_API_KEY=
CUSTOMER_IO_TRACK_SITE_ID=
CUSTOMER_IO_TRACK_API_KEY=
